[Unit]
Description=PPF PROFI Agent HQ staging health and safety check

[Service]
Type=oneshot
User=ppf-agent
Group=ppf-agent
WorkingDirectory=/opt/ppf-agent-hq
EnvironmentFile=/etc/ppf-agent-hq/monitor.env
ExecStart=/usr/bin/env node /opt/ppf-agent-hq/scripts/agent-hq-monitor.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0077

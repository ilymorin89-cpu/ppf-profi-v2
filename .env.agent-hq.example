# Agent HQ runtime environment template.
# Store actual URLs and API credentials only in the Timeweb secret/environment manager.
# Never commit a populated .env file. Never point this runtime at the PPF PROFI website database.
AGENT_HQ_WORKERS_ENABLED=false
AGENT_HQ_SUPERVISOR_ENABLED=false
OPENAI_API_KEY=
AGENT_MODEL=
AGENT_MAX_OUTPUT_TOKENS=1200
AGENT_POLL_MS=5000
AGENT_WEB_SEARCH_ENABLED=false
AGENT_GITHUB_READ_TOKEN=
AGENT_GITHUB_REPOSITORY=
AGENT_GITHUB_REF=main

# 19 distinct PostgreSQL LOGIN URLs. Do not reuse one URL across roles.
AGENT_HQ_ENABLE_COORDINATOR=false
AGENT_HQ_DATABASE_URL_COORDINATOR=
AGENT_HQ_ENABLE_WEB_ENGINEER=false
AGENT_HQ_DATABASE_URL_WEB_ENGINEER=
AGENT_HQ_ENABLE_SEO=false
AGENT_HQ_DATABASE_URL_SEO=
AGENT_HQ_ENABLE_GEO=false
AGENT_HQ_DATABASE_URL_GEO=
AGENT_HQ_ENABLE_GROWTH=false
AGENT_HQ_DATABASE_URL_GROWTH=
AGENT_HQ_ENABLE_ANALYTICS=false
AGENT_HQ_DATABASE_URL_ANALYTICS=
AGENT_HQ_ENABLE_QA_SECURITY=false
AGENT_HQ_DATABASE_URL_QA_SECURITY=
AGENT_HQ_ENABLE_VK_STRATEGIST=false
AGENT_HQ_DATABASE_URL_VK_STRATEGIST=
AGENT_HQ_ENABLE_COPYWRITER=false
AGENT_HQ_DATABASE_URL_COPYWRITER=
AGENT_HQ_ENABLE_DESIGNER=false
AGENT_HQ_DATABASE_URL_DESIGNER=
AGENT_HQ_ENABLE_IMAGE_GENERATOR=false
AGENT_HQ_DATABASE_URL_IMAGE_GENERATOR=
AGENT_HQ_ENABLE_STORYTELLER=false
AGENT_HQ_DATABASE_URL_STORYTELLER=
AGENT_HQ_ENABLE_COMMUNITY_MANAGER=false
AGENT_HQ_DATABASE_URL_COMMUNITY_MANAGER=
AGENT_HQ_ENABLE_CONTENT_SEO=false
AGENT_HQ_DATABASE_URL_CONTENT_SEO=
AGENT_HQ_ENABLE_ADS_MANAGER=false
AGENT_HQ_DATABASE_URL_ADS_MANAGER=
AGENT_HQ_ENABLE_TREND_SCOUT=false
AGENT_HQ_DATABASE_URL_TREND_SCOUT=
AGENT_HQ_ENABLE_AUTO_NEWS_EDITOR=false
AGENT_HQ_DATABASE_URL_AUTO_NEWS_EDITOR=
AGENT_HQ_ENABLE_AUTO_LAW_MONITOR=false
AGENT_HQ_DATABASE_URL_AUTO_LAW_MONITOR=
AGENT_HQ_ENABLE_FACT_CHECKER=false
AGENT_HQ_DATABASE_URL_FACT_CHECKER=

# Dedicated control identity; never reuse a worker LOGIN.
AGENT_HQ_DATABASE_URL_SUPERVISOR=

# Read-only staging preflight only; separate from Compose runtime variables.
STAGING_DATABASE_URL=
AGENT_HQ_STAGING_DATABASE=agent_hq_staging

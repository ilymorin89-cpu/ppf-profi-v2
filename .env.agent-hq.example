# Copy to .env for an isolated staging environment only.
# Never commit real credentials or use the website production database.
AGENT_HQ_WORKERS_ENABLED=false
OPENAI_API_KEY=
AGENT_MODEL=

# Gateway health endpoint: dedicated Agent HQ staging database URL.
# Must point to the isolated Agent HQ database, never the website database.
AGENT_HQ_DATABASE_URL=

# Each worker process must use a distinct PostgreSQL LOGIN.
AGENT_HQ_DATABASE_URL_COORDINATOR=
AGENT_HQ_DATABASE_URL_SEO=
AGENT_HQ_DATABASE_URL_QA_SECURITY=
AGENT_HQ_DATABASE_URL_SUPERVISOR=
AGENT_HQ_DATABASE_URL_WEB_ENGINEER=
AGENT_HQ_DATABASE_URL_ANALYTICS=
AGENT_HQ_DATABASE_URL_COMMUNITY_MANAGER=

AGENT_MAX_OUTPUT_TOKENS=1200
AGENT_POLL_MS=5000
AGENT_WEB_SEARCH_ENABLED=false

# Optional read-only GitHub integration. Use Contents: Read only.
GITHUB_TOKEN=
AGENT_GITHUB_REPOSITORY=
AGENT_GITHUB_REF=agent-hq/enable-research-tools

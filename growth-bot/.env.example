# Create a dedicated bot with @BotFather; do not reuse the website notification bot.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user or group ID allowed to control the bot.
TELEGRAM_ALLOWED_CHAT_ID=
SITE_URL=https://ppfprofi.ru
SCAN_INTERVAL_HOURS=24

# Persistent state volume; mount /data on the Timeweb service
BUDGET_STATE_PATH=/data/growth-bot-state.json
AUDIT_LOG_PATH=/data/audit.jsonl

# Future provider integrations — keep empty until credentials are configured in Timeweb secrets
GITHUB_DEPLOY_TOKEN=
YANDEX_DIRECT_TOKEN=
VK_ADS_TOKEN=
YANDEX_METRIKA_TOKEN=
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=
